# API key: key OpenRouter (sk-or-...) ATAU key dari dashboard 9router/gateway lain.
OPENROUTER_API_KEY=isi_api_key_di_sini
# Nama model dipakai APA ADANYA (tidak dipilih otomatis, tidak ditambahi ':free').
# - OpenRouter resmi: wajib berakhiran :free (atau router gratis 'openrouter/free')
# - 9router/gateway sendiri: nama model/combo persis seperti di dashboard
OPENROUTER_MODEL=isi_nama_model_gratis_di_sini
# Endpoint OpenAI-compatible; harus berakhiran /v1. Contoh memakai 9router:
#   OPENROUTER_BASE_URL=http://localhost:20128/v1
#   OPENROUTER_BASE_URL=https://xxxx.ngrok-free.app/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=120        # batas waktu satu permintaan LLM (detik); combo/ngrok bisa lebih lama
WHISPER_MODEL=small
WHISPER_DEVICE=auto          # auto/cuda/cpu
WHISPER_COMPUTE_TYPE=auto    # float16 untuk GPU, int8 untuk CPU
CLIP_MIN_SECONDS=30
CLIP_MAX_SECONDS=60
MAX_CLIPS=5
LANGUAGE=id
FACE_TRACKING=false          # false = crop tengah, true = ikuti wajah (opsional)
FACE_TRACK_SAMPLE_FPS=10     # berapa kali deteksi wajah per detik (makin tinggi makin akurat & makin lambat)
FACE_TRACK_SMOOTH=5          # jendela perataan lintasan wajah (5 = sangat halus, 1 = mengikuti apa adanya)
FACE_DETECT_WIDTH=640        # lebar frame untuk deteksi wajah (640 = cepat, 1280 = lebih rinci)
MAX_SOURCE_HEIGHT=1080       # batas tinggi video yang diunduh (0 = tanpa batas)
DOWNLOAD_PROGRESS_SECONDS=15 # jarak minimal antar baris progress unduhan (0 = hanya tiap 10%)
YT_COOKIES_FILE=             # opsional: path cookies.txt untuk yt-dlp (hanya kalau YouTube minta verifikasi bot)
YT_PLAYER_CLIENTS=           # opsional: player client yang dicoba saat verifikasi bot, mis. tv,ios,web_safari,mweb (kosong = tv,ios,web_safari)
YT_JS_RUNTIMES=             # opsional: runtime JS untuk yt-dlp, mis. node,deno (kosong = auto: pakai yang ada; 'none' = matikan)
MERGE_CLIPS=false           # true = gabungkan semua klip jadi satu video (bisa juga lewat --merge)
