OPENROUTER_API_KEY=isi_api_key_di_sini
OPENROUTER_MODEL=isi_nama_model_gratis_di_sini   # model berakhiran :free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
WHISPER_MODEL=small
WHISPER_DEVICE=auto          # auto/cuda/cpu
WHISPER_COMPUTE_TYPE=auto    # float16 untuk GPU, int8 untuk CPU
CLIP_MIN_SECONDS=30
CLIP_MAX_SECONDS=60
MAX_CLIPS=5
LANGUAGE=id
FACE_TRACKING=false          # false = crop tengah, true = ikuti wajah (opsional)
MAX_SOURCE_HEIGHT=1080       # batas tinggi video yang diunduh (0 = tanpa batas)
DOWNLOAD_PROGRESS_SECONDS=15 # jarak minimal antar baris progress unduhan (0 = hanya tiap 10%)
YT_COOKIES_FILE=             # opsional: path cookies.txt untuk yt-dlp (hanya kalau YouTube minta verifikasi bot)
YT_PLAYER_CLIENTS=           # opsional: player client yang dicoba saat verifikasi bot, mis. tv,ios,web_safari,mweb (kosong = tv,ios,web_safari)
