# Environment UJI — hanya untuk pengujian otomatis dengan mock OpenRouter lokal.
# JANGAN dipakai untuk menjalankan sungguhan. API key di sini sengaja dummy.
OPENROUTER_API_KEY=dummy-test-key-not-a-real-key
OPENROUTER_MODEL=mock/test-model:free
OPENROUTER_BASE_URL=http://127.0.0.1:8792/api/v1
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
CLIP_MIN_SECONDS=30
CLIP_MAX_SECONDS=60
MAX_CLIPS=5
LANGUAGE=id
FACE_TRACKING=false